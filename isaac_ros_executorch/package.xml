<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isaac_ros_executorch</name>
  <version>5.1.0</version>
  <description>Runs an ExecuTorch program (TensorRT and CUDA backends) on Isaac ROS TensorList messages, reading and writing CUDA buffers in place.</description>

  <maintainer email="anthony@shoumikh.in">Anthony Shoumikhin</maintainer>
  <license>Apache-2.0</license>
  <author email="anthony@shoumikh.in">Anthony Shoumikhin</author>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend condition="$ISAAC_ROS_PLATFORM != arm64-fastos">cuda-toolkit-13-2</depend>
  <depend condition="$ISAAC_ROS_PLATFORM == arm64-fastos">cuda-toolkit-13-0</depend>
  <depend>executorch_conversions</depend>
  <depend>executorch_cuda_vendor</depend>
  <depend>isaac_ros_common</depend>
  <depend>isaac_ros_tensor_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>tensor_msgs</depend>

  <exec_depend>cuda_buffer_backend</exec_depend>
  <exec_depend>executorch_conversions_cpu</exec_depend>
  <exec_depend>executorch_conversions_cuda</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
