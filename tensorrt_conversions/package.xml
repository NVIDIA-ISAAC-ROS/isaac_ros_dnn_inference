  <name>tensorrt_conversions</name>
  <version>5.1.0</version>
  <description>
    Header-only converter between tensor_msgs/ExperimentalTensor (DLPack-aligned,
    backed by rosidl::Buffer) and TensorRT device bindings (device pointer +
    nvinfer1::Dims + nvinfer1::DataType), riding on the registered rosidl::Buffer
    backend. Modeled after cvcuda_conversions.
  </description>

  <maintainer email="isaac-ros-maintainers@nvidia.com">Isaac ROS Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>cuda_buffer</depend>
  <depend>isaac_ros_common</depend>
  <depend>tensor_msgs</depend>
  <depend>tensorrt</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
